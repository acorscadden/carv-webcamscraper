{
  "name": "carv-webcamscraper",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "RUN_ON_START=true bun --watch run src/index.ts",
    "tick": "bun -e 'import(\"./src/db/index.ts\"); const m = await import(\"./src/scheduler/index.ts\"); await m.runOnce(); process.exit(0)'",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node-cron": "^3.0.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "hono": "^4.12.21",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}
