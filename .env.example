# Required in production; vision pipeline is no-op without it.
ANTHROPIC_API_KEY=

# Optional. When set, all /api/* requests must send X-API-Key: <this value>.
# Leave unset for local dev — middleware becomes a no-op.
API_KEY=

# Persisted state. On Railway, mount a volume here.
DATA_DIR=./data

# Scheduler cadence (cron format). Default: every 15 min.
CRON_SCHEDULE=*/15 * * * *

# Set true to run one scrape immediately on boot (handy for dev).
RUN_ON_START=false

# Skip per-cam ticks when Open-Meteo reports is_day=false at the cam's location.
# Saves vision API spend on dark panoramas. Set to false to capture 24/7.
SKIP_NIGHT=true

# Bun/Hono port. Defaults to 3000. Leave unset locally — if 3000 is busy
# the server will bind to a free port and log it. Railway sets this for you.
# PORT=3000

LOG_LEVEL=info
USER_AGENT=carv-webcamscraper/0.1 (+me@acorscadden.com)
